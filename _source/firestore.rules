rules_version = '2';
// Paste into Firebase console > Firestore Database > Rules, then Publish.
// Visitors can only ADD a lead with exactly these fields. Nobody can read, change or delete leads
// from the website; you read them in the Firebase console.
service cloud.firestore {
  match /databases/{database}/documents {
    match /leads/{lead} {
      allow read, update, delete: if false;
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'source', 'consent', 'page', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 200
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80
        && request.resource.data.source is string
        && request.resource.data.source.size() <= 60
        && request.resource.data.consent == true
        && request.resource.data.page is string
        && request.resource.data.page.size() <= 200
        && request.resource.data.createdAt == request.time;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
